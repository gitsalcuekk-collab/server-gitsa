{
  "name": "server-gitsa",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aspirasi-db",
      "database_id": "GANTI_DENGAN_DATABASE_ID_KAMU"
    }
  ]
}
