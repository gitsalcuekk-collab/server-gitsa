{
  "name": "server-gitsa",
  "main": "index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aspirasi-db",
      "database_id": "39372066-8169-424f-b9ff-8eb436992508"
    }
  ]
}
